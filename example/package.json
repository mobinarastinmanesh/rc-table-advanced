{
  "name": "example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node ../scripts/build-docs.mjs --base /",
    "build:pages": "tsc -b && vite build --mode gh-pages && node ../scripts/build-docs.mjs --base /rc-table-advanced/",
    "lint": "npm run lint --prefix ..",
    "preview": "npm run build && vite preview"
  },
  "dependencies": {
    "rc-table-advanced": "file:..",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
